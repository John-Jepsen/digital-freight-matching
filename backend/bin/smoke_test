#!/usr/bin/env ruby
# frozen_string_literal: true

# Add lib directory to load path
$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

# Load Rails environment if available
begin
  require_relative '../config/environment'
rescue LoadError
  # Rails not available, continue without it
  puts "Warning: Rails environment not available. Some features may be limited."
end

require_relative '../lib/api_smoke_test_orchestrator'

# Run the CLI
ApiSmokeTestFramework::CLI.run(ARGV)