# Rate Limiting Environment Variables
# Copy these variables to your .env file and adjust values as needed

# Enable/disable rate limiting globally
RATE_LIMITING_ENABLED=true

# Redis configuration for rate limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_RATE_LIMIT_DB=1

# Admin IPs that bypass rate limiting (comma-separated)
# Example: ADMIN_IPS=127.0.0.1,192.168.1.100,10.0.0.1
ADMIN_IPS=

# Blocked IPs that are completely denied access (comma-separated)
# Example: BLOCKED_IPS=192.168.1.200,10.0.0.50
BLOCKED_IPS=

# Rate Limit Configuration (optional overrides)
# Global limits
GLOBAL_RATE_LIMIT=10000
GLOBAL_RATE_PERIOD=3600

# Per-IP limits
PER_IP_RATE_LIMIT=300
PER_IP_RATE_PERIOD=3600

# Authenticated user limits
AUTHENTICATED_USER_LIMIT=1000
AUTHENTICATED_USER_PERIOD=3600

# Premium user limits
PREMIUM_USER_LIMIT=2000
PREMIUM_USER_PERIOD=3600

# Burst protection
BURST_RATE_LIMIT=30
BURST_RATE_PERIOD=60
