# Development Environment Variables for Admin Dashboard

# API Configuration
REACT_APP_API_URL=http://localhost:3001
REACT_APP_API_VERSION=v1

# Admin Features
REACT_APP_ENABLE_ADMIN_ANALYTICS=true
REACT_APP_ENABLE_USER_MANAGEMENT=true
REACT_APP_ENABLE_SYSTEM_MONITORING=true

# Security (relaxed for development)
REACT_APP_ENABLE_CSP=false
REACT_APP_ENABLE_HSTS=false
REACT_APP_REQUIRE_2FA=false

# Performance
REACT_APP_ENABLE_SERVICE_WORKER=false
REACT_APP_CACHE_STRATEGY=no_cache

# Logging
REACT_APP_LOG_LEVEL=debug

# Application
REACT_APP_VERSION=$npm_package_version
REACT_APP_ENVIRONMENT=development